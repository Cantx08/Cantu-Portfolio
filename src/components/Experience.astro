---
import { experience, highlights, skills } from '../data/profile';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
---

<section
  id="experiencia"
  class="section border-t border-zinc-200 bg-zinc-50/60 dark:border-zinc-800/80 dark:bg-zinc-900/30"
  aria-labelledby="experiencia-title"
>
  <div class="container-page">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <SectionHeader
          id="experiencia-title"
          eyebrow="02 · Experiencia"
          title="Trayectoria profesional"
          description="Me enfoco en entregar software que funcione en producción y mueva métricas de negocio."
        />

        <dl class="mt-10 grid grid-cols-3 gap-4">
          {
            highlights.map((h) => (
              <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
                <dt class="text-xs leading-snug text-zinc-500 dark:text-zinc-400">{h.label}</dt>
                <dd class="order-first font-mono text-2xl font-bold text-zinc-950 dark:text-zinc-50">{h.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <ol class="relative space-y-10 border-l border-zinc-200 pl-8 dark:border-zinc-800">
        {
          experience.map((job) => (
            <li class="relative">
              <span
                class="absolute -left-[37px] top-1.5 size-3 rounded-full border-2 border-accent-500 bg-white dark:bg-zinc-950"
                aria-hidden="true"
              />
              <p class="font-mono text-xs text-zinc-500 dark:text-zinc-400">{job.period}</p>
              <h3 class="mt-1 text-lg font-semibold">
                {job.role} <span class="font-normal text-zinc-500 dark:text-zinc-400">· {job.company}</span>
              </h3>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {job.achievements.map((a) => (
                  <li class="flex gap-2.5">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-600 dark:text-accent-400" />
                    <span>{a}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Stack técnico -->
    <div id="stack" class="mt-24 scroll-mt-24" aria-labelledby="stack-title">
      <SectionHeader
        id="stack-title"
        eyebrow="03 · Stack"
        title="Stack técnico"
        description="Herramientas con las que trabajo a diario, agrupadas por capa."
      />

      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          skills.map((group) => (
            <li class="rounded-2xl border border-zinc-200 bg-white p-6 transition hover:border-accent-500/50 dark:border-zinc-800 dark:bg-zinc-900">
              <div class="flex items-center gap-3">
                <span class="grid size-9 place-items-center rounded-lg bg-accent-50 text-accent-700 dark:bg-accent-400/10 dark:text-accent-400">
                  <Icon name={group.icon} class="size-[18px]" />
                </span>
                <h3 class="text-base font-semibold">{group.category}</h3>
              </div>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <li class="badge">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
