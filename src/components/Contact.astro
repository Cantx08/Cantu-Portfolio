---
import { profile, projectTypes } from '../data/profile';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
---

<section id="contacto" class="section border-t border-zinc-200 dark:border-zinc-800/80" aria-labelledby="contacto-title">
  <div class="container-page grid gap-14 lg:grid-cols-[1fr_1.3fr]">
    <!-- Columna informativa + accesos rápidos -->
    <div>
      <SectionHeader
        id="contacto-title"
        eyebrow="04 · Contacto"
        title="¿Tienes un proyecto en mente? Hablemos."
        description="Cuéntame qué necesitas y te responderé en menos de 24 horas hábiles con los próximos pasos."
      />

      <div class="mt-10 space-y-3">
        <div class="flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-2 pl-4 dark:border-zinc-800 dark:bg-zinc-900">
          <Icon name="mail" class="size-5 shrink-0 text-zinc-500" />
          <a
            href={`mailto:${profile.email}`}
            class="min-w-0 flex-1 truncate font-mono text-sm text-zinc-900 hover:text-accent-700 dark:text-zinc-100 dark:hover:text-accent-400"
          >
            {profile.email}
          </a>
          <button
            type="button"
            data-copy-email={profile.email}
            class="btn-secondary shrink-0 px-3 py-2 text-xs"
            aria-label="Copiar email al portapapeles"
          >
            <span data-copy-idle class="inline-flex items-center gap-1.5"><Icon name="copy" class="size-4" /> Copiar</span>
            <span data-copy-done hidden class="inline-flex items-center gap-1.5 text-accent-700 dark:text-accent-400">
              <Icon name="check" class="size-4" /> ¡Copiado!
            </span>
          </button>
        </div>
        <p data-copy-status class="sr-only" role="status" aria-live="polite"></p>

        <div class="grid grid-cols-2 gap-3">
          <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <Icon name="linkedin" class="size-4" /> LinkedIn
            <span class="sr-only">(abre en una pestaña nueva)</span>
          </a>
          <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <Icon name="github" class="size-4" /> GitHub
            <span class="sr-only">(abre en una pestaña nueva)</span>
          </a>
        </div>
      </div>

      <ul class="mt-10 space-y-3 text-sm text-zinc-600 dark:text-zinc-400">
        <li class="flex items-center gap-2.5"><Icon name="mapPin" class="size-4 text-accent-600 dark:text-accent-400" /> {profile.location} · trabajo remoto</li>
        <li class="flex items-center gap-2.5"><Icon name="clock" class="size-4 text-accent-600 dark:text-accent-400" /> Zona horaria {profile.timezone}</li>
      </ul>
    </div>

    <!-- Formulario (Netlify Forms) -->
    <div class="relative rounded-2xl border border-zinc-200 bg-white p-6 shadow-xl shadow-zinc-900/5 sm:p-8 dark:border-zinc-800 dark:bg-zinc-900 dark:shadow-black/20">
      <form
        name="contact"
        method="POST"
        action="/gracias/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-contact-form
        novalidate
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="contact" />

        <!-- Honeypot antispam: oculto para personas, visible para bots -->
        <p class="hidden" aria-hidden="true">
          <label>No llenes este campo si eres humano: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="field-label">Nombre <span class="text-red-600" aria-hidden="true">*</span></label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              maxlength="80"
              placeholder="Tu nombre"
              class="field"
              aria-describedby="name-error"
            />
            <p id="name-error" class="field-error hidden" data-error-for="name"></p>
          </div>

          <div>
            <label for="email" class="field-label">Email <span class="text-red-600" aria-hidden="true">*</span></label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              maxlength="120"
              placeholder="tu@empresa.com"
              class="field"
              aria-describedby="email-error"
            />
            <p id="email-error" class="field-error hidden" data-error-for="email"></p>
          </div>
        </div>

        <div>
          <label for="subject" class="field-label">Tipo de proyecto <span class="text-red-600" aria-hidden="true">*</span></label>
          <select id="subject" name="subject" required class="field appearance-none bg-[length:16px] bg-[right_0.875rem_center] bg-no-repeat pr-10" aria-describedby="subject-error" style="background-image:url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2371717a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m6 9 6 6 6-6'/%3E%3C/svg%3E&quot;)">
            <option value="" disabled selected>Selecciona una opción</option>
            {projectTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
          <p id="subject-error" class="field-error hidden" data-error-for="subject"></p>
        </div>

        <div>
          <label for="message" class="field-label">Mensaje <span class="text-red-600" aria-hidden="true">*</span></label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            minlength="20"
            maxlength="3000"
            placeholder="Cuéntame sobre tu proyecto, objetivos y plazos…"
            class="field resize-y"
            aria-describedby="message-error"></textarea>
          <p id="message-error" class="field-error hidden" data-error-for="message"></p>
        </div>

        <div data-form-error hidden role="alert" class="flex items-start gap-2 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/50 dark:text-red-300">
          <Icon name="alert" class="mt-0.5 size-4 shrink-0" />
          <span>No se pudo enviar el mensaje. Inténtalo de nuevo o escríbeme a <a class="underline" href={`mailto:${profile.email}`}>{profile.email}</a>.</span>
        </div>

        <button type="submit" class="btn-primary w-full py-3.5" data-submit>
          <span data-submit-label class="inline-flex items-center gap-2"><Icon name="send" class="size-4" /> Enviar mensaje</span>
          <span data-submit-loading hidden class="inline-flex items-center gap-2">
            <svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"></circle>
              <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
            </svg>
            Enviando…
          </span>
        </button>
        <p class="text-center text-xs text-zinc-500">Tus datos solo se usarán para responder a tu mensaje.</p>
      </form>

      <!-- Estado de éxito -->
      <div
        data-form-success
        hidden
        tabindex="-1"
        role="status"
        class="flex flex-col items-center justify-center py-12 text-center outline-none"
      >
        <span class="grid size-16 place-items-center rounded-full bg-accent-50 text-accent-600 ring-8 ring-accent-50/50 dark:bg-accent-400/10 dark:text-accent-400 dark:ring-accent-400/5">
          <Icon name="check" class="size-8" />
        </span>
        <h3 class="mt-6 text-2xl font-bold">¡Mensaje enviado!</h3>
        <p class="mt-3 max-w-sm text-zinc-600 dark:text-zinc-400">
          Gracias por escribirme, <span data-success-name>…</span>. Revisaré tu mensaje y te responderé muy pronto.
        </p>
        <button type="button" data-form-reset class="btn-secondary mt-8">Enviar otro mensaje</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactForm, initCopyEmail } from '../scripts/contact';
  initContactForm();
  initCopyEmail();
</script>
