---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
}
const { id, eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>}
</div>
