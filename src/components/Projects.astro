---
import { projects } from "../data/profile";
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";

const gradients = [
  "from-accent-400/30 via-teal-400/10 to-transparent",
  "from-sky-400/30 via-indigo-400/10 to-transparent",
  "from-amber-400/30 via-rose-400/10 to-transparent",
];
---

<section
  id="proyectos"
  class="section border-t border-zinc-200 dark:border-zinc-800/80"
  aria-labelledby="proyectos-title"
>
  <div class="container-page">
    <SectionHeader
      id="proyectos-title"
      eyebrow="01 · Proyectos"
      title="Proyectos destacados"
      description="Una selección de trabajos que resuelven problemas reales, desde la gestión de negocios hasta la consulta de bases de datos de grafos."
    />

    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => (
        <li class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-zinc-300 hover:shadow-xl hover:shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-zinc-700 dark:hover:shadow-black/30">
          <div class="relative aspect-[16/10] overflow-hidden border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900">
            {project.image ? (
              <img
                src={project.image}
                alt={`Captura de ${project.name}`}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition duration-500 group-hover:scale-105"
              />
            ) : (
              <div
                class={`flex size-full flex-col bg-gradient-to-br ${gradients[i % gradients.length]}`}
                aria-hidden="true"
              >
                <div class="flex gap-1.5 p-3">
                  <span class="size-2 rounded-full bg-zinc-300 dark:bg-zinc-700" />
                  <span class="size-2 rounded-full bg-zinc-300 dark:bg-zinc-700" />
                  <span class="size-2 rounded-full bg-zinc-300 dark:bg-zinc-700" />
                </div>
                <div class="flex flex-1 items-center justify-center">
                  <span class="font-mono text-5xl font-bold text-zinc-900/10 transition group-hover:text-zinc-900/20 dark:text-white/10 dark:group-hover:text-white/20">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
              </div>
            )}
          </div>

          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-lg font-semibold">{project.name}</h3>

            <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {project.description}
            </p>

            <ul
              class="mt-5 flex flex-wrap gap-1.5"
              aria-label="Tecnologías utilizadas"
            >
              {project.stack.map((tech) => (
                <li class="badge">{tech}</li>
              ))}
            </ul>

            <div class="mt-auto flex gap-5 pt-6 text-sm font-semibold">
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-zinc-900 transition hover:text-accent-700 dark:text-zinc-100 dark:hover:text-accent-400"
              >
                <Icon name="github" class="size-4" /> Ver código
                <span class="sr-only">: {project.name} (abre en una pestaña nueva)</span>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
