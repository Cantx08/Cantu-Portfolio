---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---

<Layout title={`404 — ${profile.name}`}>
  <main id="contenido" class="grid min-h-dvh place-items-center px-4 text-center">
    <div>
      <p class="font-mono text-sm text-accent-700 dark:text-accent-400">Error 404</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight">Esta ruta no existe</h1>
      <p class="mt-4 font-mono text-sm text-zinc-500">$ cd ~/inicio</p>
      <a href="/" class="btn-primary mt-8">Volver al inicio</a>
    </div>
  </main>
</Layout>
